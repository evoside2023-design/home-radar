# Backend Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=domradar
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT Configuration
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=7d

# API Keys
# OLX Partner API (https://developer.olx.pl)
OLX_CLIENT_ID=your_olx_client_id
OLX_CLIENT_SECRET=your_olx_client_secret
OLX_API_BASE_URL=https://api.olx.pl/v1
OLX_OAUTH_URL=https://oauth.olx.pl/oauth/token
OLX_REDIRECT_URI=http://localhost:5000/api/auth/olx/callback
OLX_USE_MOCK=false

# Otodom API (jeśli dostępne)
OTODOM_API_KEY=your_otodom_api_key

# External Services
GOOGLE_MAPS_API_KEY=your_google_maps_key
YELP_API_KEY=your_yelp_api_key
WALK_SCORE_API_KEY=your_walk_score_key

# Email Configuration (Nodemailer/SendGrid)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_email_password
SENDGRID_API_KEY=your_sendgrid_key

# Stripe (Payment)
STRIPE_PUBLIC_KEY=your_stripe_public_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Monitoring & Analytics
SENTRY_DSN=your_sentry_dsn
GOOGLE_ANALYTICS_ID=your_ga_id
